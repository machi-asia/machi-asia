{
  "name": "@machi-asia/media-library",
  "version": "0.1.0",
  "private": true,
  "description": "Media asset management library for machi-asia — upload, gallery/list views, realtime sync, and importable Next.js route handlers.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./routes/media": {
      "types": "./dist/routes/media.d.ts",
      "import": "./dist/routes/media.js"
    },
    "./routes/media-by-id": {
      "types": "./dist/routes/media-by-id.d.ts",
      "import": "./dist/routes/media-by-id.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'No ESLint configured yet' && exit 0",
    "lint:style": "echo 'No style lint configured yet' && exit 0",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@machi-asia/auth": "*",
    "@machi-asia/ui": "*",
    "@supabase/supabase-js": "^2.49.4",
    "jose": "^6.0.11",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "next": "^15.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "jest": "^30.4.2",
    "next": "^16.3.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ts-jest": "^29.4.0",
    "typescript": "^7.0.2"
  }
}