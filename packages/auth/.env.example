# Supabase project URL (https://<project-ref>.supabase.co)
SUPABASE_URL=

# Publishable key (sb_publishable_... or legacy anon key) - used for signup/login/refresh
SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_... or legacy service_role key) - SERVER ONLY, used for admin operations
SUPABASE_SERVICE_ROLE_SECRET=

# Shared secret required in the x-admin-secret header on /api/admin/* endpoints
ADMIN_API_SECRET=

# Comma-separated list of allowed CORS origins (e.g. "https://rose.example.com,https://tween.example.com").
# Leave empty to allow any localhost origin (development only).
ALLOWED_ORIGINS=
