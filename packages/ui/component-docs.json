      "apiEndpoints": [],
      "dependencies": [],
      "usage": "<ScrollZoom mode=\"zoom-in\">..</ScrollZoom>",
      "notes": []
    },
    "ScrollCurtain": {
      "description": "Curtain reveal on scroll.",
      "requiresAuth": false,
      "requiresProviders": [],
      "requiresEnv": [],
