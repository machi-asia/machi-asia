      "notes": []
    },
    "ScrollRotate": {
      "description": "Rotate-on-scroll wrapper.",
      "requiresAuth": false,
      "requiresProviders": [],
      "requiresEnv": [],
      "apiEndpoints": [],
      "dependencies": [],
      "usage": "<ScrollRotate>..</ScrollRotate>",
      "notes": []
    },
    "ScrollSplit": {
      "description": "Split-on-scroll reveal wrapper.",
      "requiresAuth": false,
      "requiresProviders": [],
      "requiresEnv": [],
      "apiEndpoints": [],
      "dependencies": [],
      "usage": "<ScrollSplit direction=\"vertical\">..</ScrollSplit>",
      "notes": []
    },
    "ScrollDepth": {
      "description": "Depth-of-field style scroll reveal.",
      "requiresAuth": false,
      "requiresProviders": [],
      "requiresEnv": [],
      "apiEndpoints": [],
      "dependencies": [],
      "usage": "<ScrollDepth>..</ScrollDepth>",
      "notes": []
    }
  }
}