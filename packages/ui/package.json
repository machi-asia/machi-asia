{
  "name": "@machi-asia/ui",
  "version": "0.2.1",
  "description": "Animated, mobile-friendly reusable React components.",
  "license": "MIT",
  "author": "Machi",
  "repository": {
    "type": "git",
    "url": "https://github.com/machi-asia/component-library.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "next dev playground",
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/inject-css.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'No ESLint configured yet' && exit 0",
    "lint:style": "echo 'No style lint configured yet' && exit 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview:pack": "npm run build && npm pack --dry-run"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.0.1",
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
