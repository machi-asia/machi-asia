{
  "name": "@machi-asia/rose",
  "version": "0.1.0",
  "private": true,
  "description": "Rose — a general-purpose AI companion powered by Google Gemini, exposed as importable library code, React components, and Next.js route handlers.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./routes/chat": {
      "types": "./dist/routes/chat.d.ts",
      "import": "./dist/routes/chat.js"
    },
    "./routes/usage": {
      "types": "./dist/routes/usage.d.ts",
      "import": "./dist/routes/usage.js"
    },
    "./routes/sessions": {
      "types": "./dist/routes/sessions.d.ts",
      "import": "./dist/routes/sessions.js"
    },
    "./routes/memories": {
      "types": "./dist/routes/memories.d.ts",
      "import": "./dist/routes/memories.js"
    },
    "./routes/*": {
      "types": "./dist/routes/*.d.ts",
      "import": "./dist/routes/*.js"
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "styles.css",
    "assets"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'No ESLint configured yet' && exit 0",
    "lint:style": "echo 'No style lint configured yet' && exit 0",
    "test": "echo 'No tests yet' && exit 0"
  },
  "dependencies": {
    "@machi-asia/auth": "*",
    "@machi-asia/ui": "*",
    "@supabase/supabase-js": "^2.112.4",
    "lucide-react": "^1.37.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "peerDependencies": {
    "next": "^15.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2"
  }
}
