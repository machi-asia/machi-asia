{
  "name": "@machi-asia/api-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Token-verifying reverse proxy library for machi-asia — JWT gating, weekly usage limits, and upstream forwarding as importable Next.js middleware and route handlers.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./routes/health": {
      "types": "./dist/routes/health.d.ts",
      "import": "./dist/routes/health.js"
    },
    "./routes/usage": {
      "types": "./dist/routes/usage.d.ts",
      "import": "./dist/routes/usage.js"
    },
    "./routes/gateway": {
      "types": "./dist/routes/gateway.d.ts",
      "import": "./dist/routes/gateway.js"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "import": "./dist/middleware.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'No ESLint configured yet' && exit 0",
    "test": "jest"
  },
  "dependencies": {
    "@machi-asia/ui": "*",
    "@supabase/supabase-js": "^2.112.3",
    "jose": "^6.2.10",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "next": "^15.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "jest": "^30.5.0",
    "next": "^16.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ts-jest": "^29.4.0",
    "typescript": "^7.0.2"
  }
}