# Supabase project URL (without trailing slash)
SUPABASE_URL=https://your-project.supabase.co

# Supabase anon key (used server-side for JWKS verification)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role secret (server-side only, for admin operations)
SUPABASE_SERVICE_ROLE_SECRET=your-service-role-secret

# Public Supabase URL (client-side, same as SUPABASE_URL but prefixed for Next.js)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Storage bucket name for media uploads (default: "media")
MEDIA_STORAGE_BUCKET=media
