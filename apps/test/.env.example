# ---------------------------------------------------------------------------
# apps/test — Component Explorer environment variables
# ---------------------------------------------------------------------------

# Base URL of the auth API used by the auth client. Leave empty for same-origin
# (/api/auth), which is how the auth routes are mounted in this app.
NEXT_PUBLIC_AUTH_API_URL=

# Base URL of the API gateway service. Leave empty for same-origin.
NEXT_PUBLIC_GATEWAY_URL=

# Supabase project URL (https://<project-ref>.supabase.co)
SUPABASE_URL=

# Supabase publishable key (sb_publishable_... or legacy anon key) - used by the
# hosted auth route handlers for signup/login/refresh and access-token refresh
SUPABASE_PUBLISHABLE_KEY=

# Supabase service role secret - SERVER ONLY, used by rose/media/auth route
# handlers for admin operations
SUPABASE_SERVICE_ROLE_SECRET=

# Shared secret required in the x-admin-secret header on /api/admin/* endpoints
# (used by the auth package's admin role route)
ADMIN_API_SECRET=

# Public Supabase URL + anon key used by the browser for Realtime subscriptions
# (e.g. Rose UsageBar usage updates, Media Library insert/update events)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gemini API key used by the Rose chat/agent route handlers
GEMINI_API_KEY=

# Gemini model identifier (default: gemini-2.0-flash)
GEMINI_MODEL=

# Shared gateway secret the rose routes accept when proxied (x-gateway-secret)
INTERNAL_GATEWAY_SECRET=

# Comma-separated list of allowed CORS origins for cross-origin client requests.
# Leave empty to allow any localhost origin (development only).
ALLOWED_ORIGINS=

# Rose per-tier usage limits applied by the rose usage route handlers
ROSE_DAILY_LIMIT_GUEST=10
ROSE_WEEKLY_LIMIT_GUEST=50
ROSE_DAILY_LIMIT_USER=20
ROSE_WEEKLY_LIMIT_USER=200