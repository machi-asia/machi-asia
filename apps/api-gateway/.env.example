# Supabase project URL (https://<project-ref>.supabase.co) - used to fetch JWKS for token verification
SUPABASE_URL=

# Public Supabase URL and anon key for client-side Realtime subscriptions
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret key (sb_secret_... or legacy service_role key) - SERVER ONLY, used for usage tracking writes
SUPABASE_SERVICE_ROLE_SECRET=

# Shared secret forwarded as x-gateway-secret to upstream microservices so
# they can reject requests that did not pass through this gateway.
INTERNAL_GATEWAY_SECRET=

# Maximum requests per user per week (default: 1000)
WEEKLY_USAGE_LIMIT=

# ---------------------------------------------------------------------------
# Service upstreams (one env var per registered microservice)
#
# Routes come from the code-side registry in lib/services.ts. Each entry names
# its own URL variable; set it here or on your deployment platform.
#
# AUTH_SERVICE_URL=https://auth.internal.example

# When a service's URL var is unset, the gateway falls back to
# http://localhost:<devPort> - but only outside production.
#   true  -> force the localhost fallback on, even in production
#   false -> hard-disable it everywhere
# unset -> dev-only default (enabled unless NODE_ENV=production)
GATEWAY_ALLOW_LOCAL_FALLBACK=
