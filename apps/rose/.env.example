# Auth service API URL (used by @machi-asia/auth for login/register/guest/logout)
NEXT_PUBLIC_AUTH_API_URL=http://localhost:4000

# Google Gemini API key — used for all LLM inference
# Obtain from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Shared secret expected in x-gateway-secret header from the api-gateway.
# Requests without a valid secret are rejected.
INTERNAL_GATEWAY_SECRET=

# Supabase project URL (for usage bar Realtime subscriptions)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon key (client-side auth for usage bar)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key (server-side usage queries)
SUPABASE_SERVICE_ROLE_SECRET=
