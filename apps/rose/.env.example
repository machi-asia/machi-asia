# Base URL of the auth API used by the auth client. Leave empty to use the
# same origin — this app hosts /api/auth itself.
NEXT_PUBLIC_AUTH_API_URL=

# Google Gemini API key — used by the /api/rose chat routes for LLM inference.
# Obtain from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Supabase project URL. Mirrored by NEXT_PUBLIC_SUPABASE_URL for browser use.
SUPABASE_URL=

# Supabase publishable key — used by the hosted auth routes server-side.
SUPABASE_PUBLISHABLE_KEY=

# Supabase service-role key — server-side chat sessions, usage tracking, and
# access-token verification in middleware.
SUPABASE_SERVICE_ROLE_SECRET=

# Supabase project URL for browser Realtime subscriptions (UsageBar live updates).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon key — usable in the browser bundle.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Shared secret for admin APIs (auth admin roles route).
ADMIN_API_SECRET=

# AI Chatbot Usage Limits:
# Guest tier limits (default: 10/day, 50/week)
ROSE_DAILY_LIMIT_GUEST=10
ROSE_WEEKLY_LIMIT_GUEST=50

# Authenticated user tier limits (default: 20/day, 200/week)
ROSE_DAILY_LIMIT_USER=20
ROSE_WEEKLY_LIMIT_USER=200

# Admin tier limits: unlimited (no restrictions)

# Comma-separated list of allowed CORS origins. Leave empty to allow any
# localhost origin in development.
ALLOWED_ORIGINS=